[Unit]
Description=boxcode db control-plane
After=network.target

[Service]
# /opt/node24, not /usr/bin/node: this service needs node:sqlite, which
# needs Node 22.5+; the system node the auth control-plane already runs on
# is v18 on this box, and there's no reason to touch that for a need only
# this service has. See setup.sh for why it's a dedicated download rather
# than a system upgrade.
ExecStart=/opt/node24/bin/node /opt/boxcode-db/control-plane/index.mjs
Restart=on-failure
RestartSec=2
Environment=REGISTRY_PATH=/opt/boxcode-db/registry.json
Environment=DATA_DIR=/opt/boxcode-db/data
Environment=PORT=8081
# Root only because /opt/boxcode-db needs creating on first run, same as
# the auth control-plane's own reasoning -- this service shells out to
# nothing and touches no other system state, so root is a wider grant
# than it actually needs. A dedicated non-root service user owning
# /opt/boxcode-db is the first thing to add if this box stops being
# single-tenant-per-project-trusted.
User=root

[Install]
WantedBy=multi-user.target
