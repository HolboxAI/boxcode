[Unit]
Description=boxcode change-request control-plane
After=network.target

[Service]
# System node is fine here -- unlike infra/db, nothing in this service
# needs node:sqlite or any other recent-Node feature.
ExecStart=/usr/bin/node /opt/boxcode-requests/control-plane/index.mjs
Restart=on-failure
RestartSec=2
Environment=STORE_PATH=/opt/boxcode-requests/requests.json
Environment=PORT=8082
Environment=ALLOWED_ORIGIN=https://boxcode.sh
# Root only because /opt/boxcode-requests needs creating on first run, same
# reasoning as the auth/db control-planes -- this service shells out to
# nothing and touches no other system state, so root is a wider grant than
# it actually needs. A dedicated non-root service user is the first thing
# to add if this box stops being single-tenant-per-project-trusted.
User=root

[Install]
WantedBy=multi-user.target
