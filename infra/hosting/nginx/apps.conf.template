# Base vhost for apps.boxcode.sh -- the origin CloudFront sends /api/* to.
#
# Needs a real owned domain, same as auth.boxcode.sh: Let's Encrypt refuses
# *.compute.amazonaws.com outright ("forbidden by policy") because anyone can
# get one free, and an ACM cert cannot be handed to plain nginx at all. See
# infra/auth/nginx/auth.conf.template, which learned that the hard way.
#
# Listens on 80 only; setup.sh runs certbot afterwards and certbot adds the 443
# block and the redirect itself.

# WebSockets. Connection must say "upgrade" only when the client actually asked
# to, or keep-alive breaks for every ordinary request. One of the things that
# was simply not possible on Lambda.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name apps.boxcode.sh;

    # Demo backends, not a CDN. A small cap costs nothing legitimate and takes
    # an easy amplification lever away.
    client_max_body_size 10m;

    location = /healthz {
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # An id nobody has deployed lands here rather than on nginx's welcome page.
    location / {
        return 404 "no app deployed at this path\n";
        add_header Content-Type text/plain;
    }

    # One file per live app, written by the control-plane. Never written into
    # this file: certbot edits this one in place, and regenerating it from the
    # template would destroy that edit.
    include /etc/nginx/conf.d/app-projects/*.conf;
}
