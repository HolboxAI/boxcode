# Terraform working files -- state, provider binaries, and the lockfile's
# platform-specific hashes are not something a repo should carry.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
kill-switch.zip
# archive_file writes the zip next to the module. The name comes from
# output_path, which is .terraform-prefixed, so the bare name above never
# matched it.
.terraform-*
