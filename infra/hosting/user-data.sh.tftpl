#!/usr/bin/env bash
# Boot for the runner box. Runs unattended on every launch, including the 3am
# spot replacement nobody is awake for -- so it has to be complete, idempotent,
# and loud in the log when it is not.
#
# This is a Terraform templatefile, so brace-substitutions belong to Terraform
# and every *shell* variable has to double its dollar sign to survive templating.
# Getting that backwards fails at plan time if the name is unknown to Terraform,
# and silently blanks the variable if it happens to be known -- the second is the
# dangerous one. The comment you are reading originally tripped over this rule by
# quoting both forms literally.
#
# Three jobs, in order, because each depends on the last:
#   1. attach and mount the data volume  -- the registry and Postgres live there
#   2. fetch the infra/hosting bundle    -- setup.sh is not baked into the AMI
#   3. run setup.sh                      -- provisions Docker, gVisor, nginx, PG
set -euo pipefail
exec > >(tee /var/log/boxcode-boot.log | logger -t boxcode-boot) 2>&1

VOLUME_ID="${data_volume_id}"
BUCKET="${bucket}"
REGION="${region}"
MOUNT=/opt/boxcode-hosting

echo "== boxcode runner boot: $(date -Is) =="

TOKEN=$(curl -sX PUT http://169.254.169.254/latest/api/token \
    -H 'X-aws-ec2-metadata-token-ttl-seconds: 300')
INSTANCE_ID=$(curl -s http://169.254.169.254/latest/meta-data/instance-id \
    -H "X-aws-ec2-metadata-token: $${TOKEN}")
echo "instance $${INSTANCE_ID}, volume $${VOLUME_ID}"

dnf install -y awscli unzip >/dev/null

echo "== attach the data volume =="
# The instance this is replacing may still be detaching. Spot gives two minutes
# of warning and termination is not instant, so retry rather than failing the
# boot -- a launch that gave up here would leave the group replacing forever.
for attempt in $(seq 1 30); do
    STATE=$(aws ec2 describe-volumes --region "$${REGION}" --volume-ids "$${VOLUME_ID}" \
        --query 'Volumes[0].State' --output text 2>/dev/null || echo unknown)
    if [ "$${STATE}" = "available" ]; then
        aws ec2 attach-volume --region "$${REGION}" --volume-id "$${VOLUME_ID}" \
            --instance-id "$${INSTANCE_ID}" --device /dev/sdf >/dev/null
        break
    fi
    if [ "$${STATE}" = "in-use" ]; then
        # Already ours? Then a previous boot got this far and we are re-running.
        HOLDER=$(aws ec2 describe-volumes --region "$${REGION}" --volume-ids "$${VOLUME_ID}" \
            --query 'Volumes[0].Attachments[0].InstanceId' --output text)
        [ "$${HOLDER}" = "$${INSTANCE_ID}" ] && break
        echo "volume still attached to $${HOLDER}, waiting ($${attempt}/30)"
    else
        echo "volume state '$${STATE}', waiting ($${attempt}/30)"
    fi
    sleep 10
done

echo "== find the device =="
# Nitro instances present EBS as NVMe with unpredictable numbering -- /dev/sdf
# is a request, not a promise. The volume id (dashes stripped) is the NVMe
# serial, which is the only reliable way to identify it.
SERIAL=$(echo "$${VOLUME_ID}" | tr -d '-')
DEV=""
for attempt in $(seq 1 30); do
    DEV=$(lsblk -dno NAME,SERIAL | awk -v s="$${SERIAL}" '$2 == s { print "/dev/" $1 }')
    [ -n "$${DEV}" ] && break
    sleep 2
done
if [ -z "$${DEV}" ]; then
    echo "could not find a block device with serial $${SERIAL}" >&2
    lsblk -o NAME,SERIAL,SIZE >&2
    exit 1
fi
echo "data volume is $${DEV}"

echo "== mount =="
# blkid is the idempotency check: a volume that already has a filesystem is one
# carrying live project state, and formatting it would delete every hosted app's
# database. There is no second chance on this one.
if ! blkid "$${DEV}" >/dev/null 2>&1; then
    echo "no filesystem found; this is a new volume, formatting"
    mkfs.xfs "$${DEV}"
else
    echo "existing filesystem found; keeping it"
fi
mkdir -p "$${MOUNT}"
grep -q "$${MOUNT}" /etc/fstab || echo "UUID=$(blkid -s UUID -o value "$${DEV}") $${MOUNT} xfs defaults,nofail 0 2" >> /etc/fstab
mount -a
df -h "$${MOUNT}"

echo "== fetch the hosting bundle =="
rm -rf /tmp/hosting && mkdir -p /tmp/hosting
aws s3 cp "s3://$${BUCKET}/hosting/bundle.zip" /tmp/hosting/bundle.zip --region "$${REGION}"
unzip -q -o /tmp/hosting/bundle.zip -d /tmp/hosting

echo "== setup.sh =="
if [ ! -x /tmp/hosting/setup.sh ] && [ ! -f /tmp/hosting/setup.sh ]; then
    echo "bundle has no setup.sh -- box is mounted but not provisioned." >&2
    echo "This is expected until infra/hosting/setup.sh ships; the volume and" >&2
    echo "network are ready for it." >&2
    exit 0
fi
BOXCODE_DATA_DIR="$${MOUNT}" bash /tmp/hosting/setup.sh

echo "== boot complete: $(date -Is) =="
